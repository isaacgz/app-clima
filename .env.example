# Clave de Mapbox para buscar lugares por nombre (plan gratuito)
MAPBOX_KEY=

# MET Norway (clima y pronóstico) no usa clave, pero exige un User-Agent con datos de contacto.
# Pon el nombre de tu app y un correo o URL propios, p. ej.: mi-app/1.0 tucorreo@ejemplo.com
MET_USER_AGENT=

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Si se define, las rutas /api exigen el header X-Api-Key con este valor (recomendado en producción)
API_KEY=

# Dominio autorizado para llamar a la API desde el navegador (opcional, por defecto *)
CORS_ORIGIN=
